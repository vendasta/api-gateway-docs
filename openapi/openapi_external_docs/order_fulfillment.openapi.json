      "v1UpsertFulfillmentFormSubmissionRequest": {
        "properties": {
          "appId": {
            "description": "Required. The app in the sales order the form is for.",
            "type": "string"
          },
          "businessId": {
            "description": "Required. The business the sales order belongs to.",
            "type": "string"
          },
          "formAnswers": {
            "description": "Optional. Answers to the form fields. Merged by field ID with the latest submission; fields not included keep their previous answers.",
            "items": {
              "$ref": "#/components/schemas/v1FormAnswers"
            },
            "type": "array"
          },
          "lastViewedTimestamp": {
            "description": "Required. The Unix time in seconds, as a string, at which the submitter loaded the form; normally the version returned by GetLatestFulfillmentFormSubmission.\nIf a newer submission exists than this value, the upsert is rejected with ALREADY_EXISTS so stale answers do not overwrite it.\nTo skip conflict detection, or when no submission exists yet, send the current Unix time.",
            "type": "string"
          },
          "salesOrderId": {
            "description": "Required. The sales order the form belongs to.",
            "type": "string"
          }
        },
        "required": [
          "salesOrderId",
          "appId",
          "businessId",
          "lastViewedTimestamp"
        ],
        "type": "object"
      },
      "v1UpsertFulfillmentFormSubmissionResponse": {
        "properties": {
          "version": {
            "description": "Output only. The version of the saved submission (Unix time in seconds, as a string).",
            "readOnly": true,
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://sso-api-prod.apigateway.co/oauth2/auth",
            "scopes": {
              "order": "Allows the application to manage orders",
              "order:read": "Allows the application view-only access to orders"
            },
            "tokenUrl": "https://sso-api-prod.apigateway.co/oauth2/token"
          }
        },
        "type": "oauth2"
      }
    }
