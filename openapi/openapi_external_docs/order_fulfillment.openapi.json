      "v1SortDirection": {
        "default": "SORT_DIRECTION_UNSET",
        "description": "The direction results are sorted in.\n\n - SORT_DIRECTION_UNSET: No sort is applied and results are returned in the search index's default order. This is the default and is a valid value for requests.",
        "enum": [
          "SORT_DIRECTION_UNSET",
          "SORT_DIRECTION_ASCENDING",
          "SORT_DIRECTION_DESCENDING"
        ],
        "type": "string"
      },
      "v1TimeField": {
        "default": "TIME_FIELD_UNSET",
        "description": "The timestamp a time-range filter applies to.\n\n - TIME_FIELD_UNSET: No time filter is applied. This is the default and is a valid value for requests.",
        "enum": [
          "TIME_FIELD_UNSET",
          "TIME_FIELD_CREATED",
          "TIME_FIELD_UPDATED",
          "TIME_FIELD_DELETED"
