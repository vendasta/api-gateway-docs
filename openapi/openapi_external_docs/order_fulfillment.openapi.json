  "paths": {
    "/v1/fulfillment-form-submission/get": {
      "post": {
        "operationId": "FulfillmentFormSubmissionService_GetLatestFulfillmentFormSubmission",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/v1GetLatestFulfillmentFormSubmissionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/v1GetLatestFulfillmentFormSubmissionResponse"
                }
              }
            },
            "description": "A successful response."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/rpcStatus"
                }
              }
            },
            "description": "An unexpected error response."
          }
        },
        "security": [
          {
            "OAuth2": [
              "order",
              "order:read"
            ]
          }
        ],
        "summary": "Get Fulfillment Form Submission",
        "tags": [
          "FulfillmentFormSubmissionService"
        ]
      }
    },
